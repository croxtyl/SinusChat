<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:paddingVertical="9dp"
    android:background="?android:attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/conv_avatar_bg"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle" />

        <TextView
            android:id="@+id/conv_avatar_letter"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:text="?"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/conv_avatar_image"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/bg_avatar_circle"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="@null" />

        <View
            android:id="@+id/conv_online_indicator"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/conv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/sinuschat_text_primary"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="User Name" />

            <ImageView
                android:id="@+id/conv_pin_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_pin"
                app:tint="?attr/sinuschat_text_muted"
                android:visibility="gone"
                android:contentDescription="@string/pinned" />

            <ImageView
                android:id="@+id/conv_mute_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_notifications_off"
                app:tint="?attr/sinuschat_text_muted"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/conv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/sinuschat_text_muted"
                android:textSize="12sp"
                android:text="14:32" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/conv_lock_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_lock"
                app:tint="?attr/sinuschat_text_muted"
                android:layout_marginEnd="5dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/conv_last_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/sinuschat_text_secondary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Last message content..." />

            <TextView
                android:id="@+id/conv_unread_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:minWidth="20dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:visibility="gone"
                android:text="1" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
