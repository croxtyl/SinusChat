<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fixed_dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="24dp"
            android:paddingVertical="34dp">

            <pl.sinusoide.sinuschat.ui.SessionMoveView
                android:id="@+id/iv_session_anim"
                android:layout_width="260dp"
                android:layout_height="150dp"
                android:contentDescription="@string/session_moved_cd" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_moved_title"
                android:textColor="@color/fixed_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/session_moved_desc"
                android:textColor="#ABAAAA"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_session_info"
                android:padding="14dp"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/iv_info_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_info"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/session_moved_hint"
                    android:textColor="#C5C5C5"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_understood"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/understand"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/fixed_white"
                android:textColor="@color/fixed_black"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
