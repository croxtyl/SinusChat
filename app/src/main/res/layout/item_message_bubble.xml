<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="6dp">

    <ImageView
        android:id="@+id/msg_sender_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="2dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/msg_bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/msg_pin_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pinned_label"
            android:drawableStart="@drawable/ic_pin"
            android:drawableTint="?attr/sinuschat_text_muted"
            android:drawablePadding="4dp"
            android:textColor="?attr/sinuschat_text_muted"
            android:textSize="11sp"
            android:paddingHorizontal="12dp"
            android:paddingBottom="3dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/msg_reply_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:background="?attr/sinuschat_surface_variant"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="2dp">
            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="?attr/colorPrimary"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/msg_reply_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/sinuschat_text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/msg_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:elevation="1dp">

            <TextView
                android:id="@+id/msg_sender_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="12dp"
                android:paddingBottom="3dp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/msg_image_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/msg_image"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:maxHeight="300dp"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginBottom="3dp"
                    android:contentDescription="@string/photo" />

                <FrameLayout
                    android:id="@+id/msg_image_overlay"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/msg_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="3dp"
                android:layout_marginBottom="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/msg_once_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/msg_once_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/msg_once_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/msg_link_preview"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:background="#1A000000"
                android:padding="8dp"
                android:layout_marginHorizontal="3dp"
                android:layout_marginBottom="6dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/msg_link_image_container"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1A000000">
                    <ImageView
                        android:id="@+id/msg_link_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/msg_link_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/msg_link_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="1dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:id="@+id/msg_link_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_link"
                            android:tint="#C0FFFFFF"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/msg_link_host"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#C0FFFFFF"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView
                            android:id="@+id/msg_link_favicon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:scaleType="centerInside"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/msg_doc_card"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:background="@drawable/bg_doc_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:layout_marginHorizontal="3dp"
                android:layout_marginBottom="3dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_doc_icon" />
                    <ImageView
                        android:id="@+id/msg_doc_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_document"
                        android:tint="#FFFFFF"
                        android:contentDescription="Plik" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/msg_doc_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="middle" />

                    <TextView
                        android:id="@+id/msg_doc_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/msg_doc_expand"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#FFFFFF"
                    android:layout_marginStart="6dp"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/code_show" />

                <ImageView
                    android:id="@+id/msg_doc_action"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_download"
                    android:tint="#FFFFFF"
                    android:layout_marginStart="8dp"
                    android:padding="4dp"
                    android:contentDescription="Pobierz" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/msg_code_box"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginHorizontal="3dp"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/msg_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/sinuschat_text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/msg_translate_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="1dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:id="@+id/msg_translated_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_translate"
                    android:contentDescription="@string/translate_translated"
                    android:visibility="gone" />
                <FrameLayout
                    android:id="@+id/msg_timer_slot"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/msg_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/sinuschat_text_muted" />
                <ImageView
                    android:id="@+id/msg_status_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"
                    android:contentDescription="Status" />
            </LinearLayout>

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/msg_reactions_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone"
            android:layout_marginTop="3dp">
            <LinearLayout
                android:id="@+id/msg_reactions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/msg_blocked_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_not_delivered"
            android:textColor="#E65100"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="12dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
