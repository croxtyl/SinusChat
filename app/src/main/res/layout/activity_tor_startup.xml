<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/sinuschat_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <LinearLayout
            android:id="@+id/group_tor_starting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/tor_ring_slot"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="22dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield"
                    android:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tor_startup_title"
                android:textColor="?attr/sinuschat_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:text="@string/tor_startup_desc"
                android:textColor="?attr/sinuschat_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="28dp" />

            <TextView
                android:id="@+id/tor_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tor_startup_building"
                android:textColor="?attr/sinuschat_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_tor_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_tor_success_circle"
                android:src="@drawable/ic_check"
                android:tint="#3DDC84"
                android:padding="18dp"
                android:importantForAccessibility="no"
                android:layout_marginBottom="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tor_ready_title"
                android:textColor="?attr/sinuschat_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:text="@string/tor_ready_desc"
                android:textColor="?attr/sinuschat_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="30dp" />

            <Button
                android:id="@+id/btn_tor_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tor_done"
                android:textColor="#FFFFFF"
                android:backgroundTint="?attr/colorPrimary"
                android:paddingHorizontal="34dp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
