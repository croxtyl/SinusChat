<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="2dp"
    android:background="?attr/sinuschat_surface_variant"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/media_item_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Media" />

    <View
        android:id="@+id/media_item_video_badge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/media_item_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:tint="?attr/colorPrimary"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            android:contentDescription="File" />

        <TextView
            android:id="@+id/media_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/sinuschat_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/media_item_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_margin="4dp"
        android:background="#A0000000" />

    <FrameLayout
        android:id="@+id/media_item_selection_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#665288C1"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_send"
            android:tint="#FFFFFF"
            android:contentDescription="Selected" />
    </FrameLayout>

</FrameLayout>
