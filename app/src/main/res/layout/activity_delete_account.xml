<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/sinuschat_background">

    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="?attr/sinuschat_surface"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="?attr/sinuschat_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/delete_account_title"
            android:textColor="?attr/sinuschat_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sinuschat_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/view_confirm"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="26dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_danger"
                            android:tint="@color/sinuschat_error"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/delete_account_confirm_q"
                            android:textColor="?attr/sinuschat_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_account_warning"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginBottom="26dp" />

                    <pl.sinusoide.sinuschat.ui.HoldButton
                        android:id="@+id/btn_hold_delete"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:gravity="center"
                        android:text="@string/delete_account_hold_action"
                        android:textAllCaps="false"
                        android:textColor="@color/sinuschat_error"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_hold_button" />

                    <Button
                        android:id="@+id/btn_cancel_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="@string/action_cancel"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp"
                        style="?attr/materialButtonOutlinedStyle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/view_countdown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_card"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_danger_circle">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_danger"
                            android:tint="@color/sinuschat_error" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_account_will_be_deleted"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:id="@+id/tv_days_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14"
                        android:textColor="@color/sinuschat_error"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tv_days_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/days_to_deletion_label"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="13sp" />

                    <GridLayout
                        android:id="@+id/calendar_grid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_delete_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="?attr/sinuschat_text_muted"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="20dp" />

                    <Button
                        android:id="@+id/btn_cancel_deletion"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/cancel_deletion"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btn_delete_now"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_immediately"
                        android:textAllCaps="false"
                        android:textColor="@color/sinuschat_error"
                        android:textSize="14sp"
                        android:layout_marginTop="12dp"
                        style="?attr/materialButtonOutlinedStyle" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/view_deleted"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_card"
                    android:padding="28dp">

                    <ImageView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:src="@drawable/ic_person_remove"
                        android:tint="@color/sinuschat_error" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_success_title"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_success_desc"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_redirect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/go_to_login_timer"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="28dp" />

                    <Button
                        android:id="@+id/btn_go_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/go_now"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:layout_marginTop="20dp"
                        style="?attr/materialButtonOutlinedStyle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
