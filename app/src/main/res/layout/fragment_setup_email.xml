<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/sinuschat_background"
    android:gravity="center_horizontal"
    android:fitsSystemWindows="true">

    <pl.sinusoide.sinuschat.ui.IconDrawView
        android:id="@+id/email_icon"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/email_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/enter_email_title"
        android:textColor="?attr/sinuschat_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/email_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/enter_email_subtitle"
        android:textColor="?attr/sinuschat_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/input_email"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:inputType="textEmailAddress"
        android:hint="email@example.com"
        android:textColor="?attr/sinuschat_text_primary"
        android:textColorHint="?attr/sinuschat_text_muted"
        android:textSize="17sp"
        android:textAlignment="center"
        android:background="@drawable/bg_input_signal"
        android:padding="12dp"
        android:layout_marginHorizontal="48dp"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/sinuschat_error"
        android:textSize="13sp"
        android:visibility="invisible"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="12dp" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        android:indeterminateTint="?attr/colorPrimary"
        android:layout_marginTop="16dp" />

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

    <Button
        android:id="@+id/btn_send_code"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/action_send_code"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="?attr/colorPrimary"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        style="@style/Widget.Material3.Button" />
</LinearLayout>
