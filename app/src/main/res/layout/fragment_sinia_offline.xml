<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/sinuschat_background">

        <View
            android:id="@+id/sinia_status_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/layout_sinia_setup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="104dp">

                    <ImageView
                        android:id="@+id/iv_sinia_hero"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="18dp"
                        android:padding="28dp"
                        android:src="@drawable/ic_sinia"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/sinia_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sinia_title"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/sinia_tagline"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="10dp"
                        android:paddingStart="4dp"
                        android:text="@string/sinia_choose_model"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tv_setup_ram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:paddingStart="4dp"
                        android:textColor="?attr/sinuschat_text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/ll_model_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/card_old_models"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_sinia_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_storage"
                            app:tint="#FFB547"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tv_old_models"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.2"
                            android:textColor="?attr/sinuschat_text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_old_models_delete"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/delete"
                            android:textAllCaps="false"
                            android:textColor="@color/sinuschat_error"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="#1FE74C3C"
                            app:cornerRadius="19dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_sinia_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/bg_sinia_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_wifi"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sinia_wifi_warn"
                            android:textColor="?attr/sinuschat_text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.25" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_download"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sinia_select_model_btn"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="29dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorOnPrimary" />

                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/layout_sinia_download"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:paddingBottom="104dp">

                    <ImageView
                        android:id="@+id/iv_download_orb"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="20dp"
                        android:padding="28dp"
                        android:src="@drawable/ic_download"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sinia_downloading_title"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_download_model"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_sinia_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_download_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="18dp"
                        android:gravity="center"
                        android:text="@string/sinia_connecting"
                        android:textColor="?attr/sinuschat_text_secondary"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/progress_download"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_sinia_progress"
                        android:progressBackgroundTint="?attr/sinuschat_surface_variant"
                        android:progressTint="?attr/colorPrimary"
                        android:indeterminateTint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_download_speed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/sinuschat_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_download_eta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/sinuschat_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_download_queue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_sinia_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/sinia_queue_title"
                            android:textColor="?attr/sinuschat_text_secondary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/ll_download_queue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:text="@string/sinia_dont_close"
                        android:textColor="?attr/sinuschat_text_muted"
                        android:textSize="12.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_download_more"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sinia_add_more_models"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/sinuschat_surface_variant"
                        app:cornerRadius="25dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_download"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sinia_cancel_all"
                        android:textAllCaps="false"
                        android:textColor="@color/sinuschat_error"
                        android:textStyle="bold"
                        app:backgroundTint="#24E74C3C"
                        app:cornerRadius="25dp" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/layout_sinia_ready"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/iv_ready_orb"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_marginBottom="20dp"
                        android:padding="30dp"
                        android:src="@drawable/ic_sinia"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sinia_ready_title"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ready_model_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_sinia_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="@string/sinia_model_format"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/card_sinia_load_warn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_sinia_card"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_warning"
                            app:tint="#FFB547"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sinia_load_warn_title"
                                android:textColor="#FFB547"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/sinia_load_warn_desc"
                                android:textColor="?attr/sinuschat_text_secondary"
                                android:textSize="13sp"
                                android:lineSpacingMultiplier="1.3" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_load_model"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sinia_load_btn"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="29dp"
                        app:icon="@drawable/ic_sinia"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_model"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/sinia_choose_other_model"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/sinuschat_surface_variant"
                        app:cornerRadius="25dp" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/layout_sinia_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_error_orb"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginBottom="20dp"
                    android:padding="28dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/sinuschat_error"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/sinia_load_error_title"
                    android:textColor="?attr/sinuschat_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_error_msg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="28dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/sinuschat_text_secondary"
                    android:textSize="13.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry_load"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/sinia_back_to_models_btn"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="27dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_sinia_chat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/sinia_topbar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp">

                    <ImageButton
                        android:id="@+id/btn_sinia_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_back"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_back"
                        android:tint="?attr/sinuschat_text_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/sinia_short"
                            android:textColor="?attr/sinuschat_text_primary"
                            android:textSize="16.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_model_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/sinuschat_text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_sinia_think"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/sinia_think"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lightbulb"
                        android:tint="?attr/sinuschat_text_primary" />

                    <ImageButton
                        android:id="@+id/btn_sinia_incognito"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Incognito"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_autodelete"
                        android:tint="?attr/sinuschat_text_primary" />

                    <ImageButton
                        android:id="@+id/btn_sinia_history"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/sinia_history_title"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_history"
                        android:tint="?attr/sinuschat_text_primary" />

                    <ImageButton
                        android:id="@+id/btn_sinia_settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/sinia_settings_title"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings"
                        android:tint="?attr/sinuschat_text_primary" />

                    <ImageButton
                        android:id="@+id/btn_sinia_clear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_reload"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_refresh"
                        android:tint="?attr/sinuschat_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_loading_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_sinia_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:indeterminateTint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sinia_loading_title"
                            android:textColor="?attr/sinuschat_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sinia_loading_desc"
                            android:textColor="?attr/sinuschat_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_chat"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp" />

                <FrameLayout
                    android:id="@+id/sinia_preview_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_image_preview"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_sinia_card"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />

                    <ImageButton
                        android:id="@+id/btn_clear_image"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-6dp"
                        android:layout_marginEnd="-6dp"
                        android:background="@drawable/bg_sinia_pill"
                        android:contentDescription="@string/delete_photo"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        android:tint="?attr/sinuschat_text_primary"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/sinia_input_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <ImageButton
                        android:id="@+id/btn_sinia_image"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/add_photo_label"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_image"
                        android:tint="?attr/sinuschat_text_primary" />

                    <EditText
                        android:id="@+id/et_sinia_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_sinia_input"
                        android:hint="@string/sinia_input_hint_sinia"
                        android:imeOptions="flagNoEnterAction"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:minHeight="46dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="11dp"
                        android:textColor="?attr/sinuschat_text_primary"
                        android:textColorHint="?attr/sinuschat_text_muted"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btn_sinia_send"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_send_btn"
                        android:contentDescription="@string/action_send"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_send"
                        android:tint="?attr/colorOnPrimary" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container_sinia"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_sinia_drawer"
        android:elevation="8dp" />

</androidx.drawerlayout.widget.DrawerLayout>
